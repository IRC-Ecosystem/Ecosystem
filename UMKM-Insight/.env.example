# Copy ke .env untuk development lokal UMKM-Insight.

APP_ENV=local
APP_DEBUG=false

# Database UMKM-Insight
DB_HOST=umkm-insight-mysql
DB_NAME=umkm_insight
DB_USER=root
DB_PASSWORD=root

# API key opsional. Jika diisi, endpoint POST integrasi wajib pakai header:
# X-API-Key: nilai-di-bawah
UMKM_API_KEY=

# Endpoint service lain.
API_INTEGRATOR_BASE_URL=http://api-integrator:4001

# Mode pull opsional untuk sinkronisasi.
# Jika kosong, UMKM-Insight memakai mode push-ready dan menunggu data dikirim ke endpoint API.
SMARTBANK_TRANSACTIONS_URL=
WARUNGPOS_TRANSACTIONS_URL=
PASARKITA_TRENDS_URL=
EXTERNAL_API_KEY=
