<%- include("../partials/header", { pageTitle, includeChartJs: true, bodyClass: "bg-[#f8fbff] text-slate-900" }) %>
  <% const safeActiveFilter = typeof activeFilter !== "undefined" ? activeFilter : "all"; %>
  <% const safeFilters = Array.isArray(typeof filters !== "undefined" ? filters : null) ? filters : []; %>
  <% const safeSummaryCards = Array.isArray(typeof summaryCards !== "undefined" ? summaryCards : null) ? summaryCards : []; %>
  <% const safeRecentTransactions = Array.isArray(typeof recentTransactions !== "undefined" ? recentTransactions : null) ? recentTransactions : []; %>
  <% const safeCashierMonitor = Array.isArray(typeof cashierMonitor !== "undefined" ? cashierMonitor : null) ? cashierMonitor : []; %>
  <% const safeRecentTransactionsPagination = typeof recentTransactionsPagination !== "undefined" && recentTransactionsPagination ? recentTransactionsPagination : { currentPage: 1, totalPages: 1, totalItems: 0 }; %>
  <% const safeChartData = typeof chartData !== "undefined" && chartData ? { labels: Array.isArray(chartData.labels) ? chartData.labels : [], totals: Array.isArray(chartData.totals) ? chartData.totals : [] } : { labels: [], totals: [] }; %>
  <% const safeTodayLabel = typeof todayLabel !== "undefined" ? todayLabel : ""; %>
  <% const safeChartRangeLabel = typeof chartRangeLabel !== "undefined" ? chartRangeLabel : "Semua data"; %>
  <div class="min-h-screen lg:flex">
    <%- include("../partials/sidebar", { sidebarTitle: "Manager Panel" ,
      sidebarDescription: "Pantau KPI, transaksi, performa kasir, dan export laporan dari satu dashboard." ,
      sidebarLinks: [ { href: `/manager?filter=${safeActiveFilter}#dashboard`, label: "Dashboard" , short: "DB" , exact:
      true }, { href: "/manager/payments" , label: "Payment" , short: "PY" , exact: true }, { href: "/manager/audit-logs" , label: "Audit Log" , short: "AL" , exact: true }, {
      href: "/manager/smartbank-wallet" , label: "Wallet Toko" , short: "SW" , exact: true }, {
      href: "/manager/api-integrator" , label: "API Integrator" , short: "API" , matchPrefix: "/manager/api-integrator"
      } ], currentPath, sessionUser }) %>

      <main class="min-w-0 flex-1">
        <header class="border-b border-blue-100 bg-white/90 px-6 py-5 backdrop-blur">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Ringkasan operasional</p>
              <h2 class="mt-1 text-3xl font-semibold tracking-tight text-slate-950">Dashboard Manager</h2>
              <p class="mt-2 text-sm text-slate-500">
                <%= safeTodayLabel %>
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <% safeFilters.forEach((item)=> { %>
                <a href="/manager?filter=<%= item.key %>"
                  class="rounded-2xl px-4 py-3 text-sm font-semibold transition <%= safeActiveFilter === item.key ? 'bg-blue-600 text-white' : 'border border-blue-100 bg-blue-50/60 text-slate-700 hover:bg-white' %>">
                  <%= item.label %>
                </a>
                <% }) %>
                  <a href="/manager/export/csv?filter=<%= safeActiveFilter %>"
                    class="rounded-2xl border border-blue-100 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-blue-50">
                    Export CSV
                  </a>
                  <a href="/manager/export/pdf?filter=<%= safeActiveFilter %>"
                    class="rounded-2xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
                    Export PDF
                  </a>
                  <div class="rounded-2xl border border-blue-100 bg-blue-50/70 px-4 py-3 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.25em] text-slate-400">Status Sistem</p>
                    <p class="mt-1 text-sm font-semibold text-emerald-600">POS Online</p>
                  </div>
            </div>
          </div>
        </header>

        <section id="dashboard" class="px-6 py-6 scroll-mt-6">
          <% if (typeof dashboardError !=='undefined' && dashboardError) { %>
            <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
              <%= dashboardError %>
            </div>
            <% } %>

              <div class="grid gap-5 xl:grid-cols-4">
                <% safeSummaryCards.forEach((card)=> { %>
                  <article class="overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-slate-200">
                    <div class="bg-gradient-to-r <%= card.accent %> p-5 text-white">
                      <p class="text-sm font-medium text-white/80">
                        <%= card.title %>
                      </p>
                      <h3 class="mt-4 text-3xl font-semibold tracking-tight">
                        <%= card.value %>
                      </h3>
                    </div>
                    <div class="p-5">
                      <p class="text-sm text-slate-500">
                        <%= card.description %>
                      </p>
                    </div>
                  </article>
                  <% }) %>
              </div>

              <div class="mt-6 space-y-6">
                <section id="laporan" class="rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-200 scroll-mt-6">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="text-xl font-semibold text-slate-950">Laporan Penjualan</h3>
                      <p class="mt-1 text-sm text-slate-500">
                        <% if (safeActiveFilter==="today" ) { %>
                          Grafik total penjualan transaksi paid per jam untuk hari ini.
                          <% } else if (safeActiveFilter==="week" ) { %>
                            Grafik total penjualan transaksi paid untuk rentang minggu ini.
                            <% } else if (safeActiveFilter==="month" ) { %>
                              Grafik total penjualan transaksi paid untuk rentang bulan ini.
                              <% } else { %>
                                Grafik total penjualan transaksi paid untuk seluruh data yang tersedia.
                                <% } %>
                      </p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                      <%= safeChartRangeLabel %>
                    </span>
                  </div>

                  <% if (safeChartData.labels.length===0 || safeChartData.totals.every((value)=> Number(value) === 0)) { %>
                    <div
                      class="mt-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-14 text-center">
                      <div
                        class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl bg-white ring-1 ring-slate-200">
                        <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 19h16M7 16l3-3 2 2 5-6" />
                        </svg>
                      </div>
                      <h4 class="mt-4 text-lg font-semibold text-slate-950">Belum ada data penjualan</h4>
                      <p class="mt-2 text-sm text-slate-500">Grafik akan terisi saat transaksi paid mulai tercatat.</p>
                    </div>
                    <% } else { %>
                      <div class="mt-6 h-80">
                        <canvas
                          id="salesChart"
                          data-labels="<%= encodeURIComponent(JSON.stringify(safeChartData.labels)) %>"
                          data-totals="<%= encodeURIComponent(JSON.stringify(safeChartData.totals)) %>"
                        ></canvas>
                      </div>
                      <% } %>
                </section>

                <section id="aktivitas" class="rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-200 scroll-mt-6">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="text-xl font-semibold text-slate-950">Transaksi Terbaru</h3>
                      <p class="mt-1 text-sm text-slate-500">6 transaksi per halaman sesuai filter periode yang dipilih.
                      </p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                      <%= safeRecentTransactionsPagination.totalItems %> data
                    </span>
                  </div>

                  <% if (safeRecentTransactions.length===0) { %>
                    <div
                      class="mt-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-14 text-center">
                      <div
                        class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl bg-white ring-1 ring-slate-200">
                        <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M20 13V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0H4" />
                        </svg>
                      </div>
                      <h4 class="mt-4 text-lg font-semibold text-slate-950">Belum ada transaksi</h4>
                      <p class="mt-2 text-sm text-slate-500">Transaksi terbaru akan tampil di sini saat data mulai
                        masuk.</p>
                    </div>
                    <% } else { %>
                      <div class="mt-6 overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200 text-sm">
                          <thead>
                            <tr class="text-left text-slate-500">
                              <th class="pb-3 font-medium">Invoice</th>
                              <th class="pb-3 font-medium">Konsumen</th>
                              <th class="pb-3 font-medium">Kasir</th>
                              <th class="pb-3 font-medium">Metode Bayar</th>
                              <th class="pb-3 font-medium">Total</th>
                              <th class="pb-3 font-medium">Status</th>
                              <th class="pb-3 font-medium">Tanggal</th>
                              <th class="pb-3 font-medium">Aksi</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-slate-100">
                            <% safeRecentTransactions.forEach((transaction)=> { %>
                              <tr class="text-slate-700">
                                <td class="py-4 font-semibold text-slate-900">
                                  <%= transaction.invoice %>
                                </td>
                                <td class="py-4">
                                  <%= transaction.customer_name %>
                                </td>
                                <td class="py-4">
                                  <%= transaction.cashier_name %>
                                </td>
                                <td class="py-4">
                                  <%= transaction.payment_method %>
                                </td>
                                <td class="py-4 font-medium">
                                  <%= transaction.grand_total_formatted %>
                                </td>
                                <td class="py-4">
                                  <span class="rounded-full px-3 py-1 text-xs font-semibold
                          <%= transaction.status === 'pending' ? 'bg-amber-100 text-amber-700' : '' %>
                          <%= transaction.status === 'approved' ? 'bg-sky-100 text-sky-700' : '' %>
                          <%= transaction.status === 'paid' ? 'bg-emerald-100 text-emerald-700' : '' %>
                          <%= transaction.status === 'rejected' ? 'bg-rose-100 text-rose-700' : '' %>
                          <%= transaction.status === 'voided' ? 'bg-slate-200 text-slate-700' : '' %>
                        ">
                                    <%= transaction.status %>
                                  </span>
                                </td>
                                <td class="py-4">
                                  <%= transaction.created_at_formatted %>
                                </td>
                                <td class="py-4">
                                  <% if (['pending', 'approved', 'pending_payment'].includes(transaction.status)) { %>
                                    <form action="/manager/transactions/<%= transaction.id %>/void" method="POST" onsubmit="return submitVoid(this, '<%= transaction.invoice %>')">
                                      <input type="hidden" name="reason">
                                      <button type="submit" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">Void</button>
                                    </form>
                                  <% } else { %>
                                    <span class="text-xs text-slate-400">-</span>
                                  <% } %>
                                </td>
                              </tr>
                              <% }) %>
                          </tbody>
                        </table>
                      </div>
                      <% if (safeRecentTransactionsPagination.totalPages> 1) { %>
                        <div
                          class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-4">
                          <p class="text-sm text-slate-500">
                            Halaman <%= safeRecentTransactionsPagination.currentPage %> dari <%=
                                safeRecentTransactionsPagination.totalPages %>
                          </p>
                          <div class="flex items-center gap-2">
                            <a href="/manager?filter=<%= safeActiveFilter %>&recentPage=<%= Math.max(1, safeRecentTransactionsPagination.currentPage - 1) %>#aktivitas"
                              class="rounded-2xl border border-slate-200 px-4 py-2 text-sm font-semibold transition <%= safeRecentTransactionsPagination.currentPage === 1 ? 'pointer-events-none bg-slate-100 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50' %>">
                              Sebelumnya
                            </a>
                            <a href="/manager?filter=<%= safeActiveFilter %>&recentPage=<%= Math.min(safeRecentTransactionsPagination.totalPages, safeRecentTransactionsPagination.currentPage + 1) %>#aktivitas"
                              class="rounded-2xl border border-slate-200 px-4 py-2 text-sm font-semibold transition <%= safeRecentTransactionsPagination.currentPage === safeRecentTransactionsPagination.totalPages ? 'pointer-events-none bg-slate-100 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50' %>">
                              Berikutnya
                            </a>
                          </div>
                        </div>
                        <% } %>
                          <% } %>
                </section>

                <section id="operasional" class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px] scroll-mt-6">
                  <article class="rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-200">
                    <h3 class="text-xl font-semibold text-slate-950">Monitor Kasir</h3>
                    <p class="mt-1 text-sm text-slate-500">Performa kasir berdasarkan transaksi paid pada periode yang
                      sedang dipilih.</p>

                    <% if (safeCashierMonitor.length===0) { %>
                      <div
                        class="mt-5 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center">
                        <div
                          class="mx-auto flex h-14 w-14 items-center justify-center rounded-3xl bg-white ring-1 ring-slate-200">
                          <svg class="h-7 w-7 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 20h5V4H2v16h5M9 20V10h6v10M9 6h6" />
                          </svg>
                        </div>
                        <h4 class="mt-4 text-base font-semibold text-slate-950">Belum ada performa kasir</h4>
                        <p class="mt-2 text-sm text-slate-500">Data kasir akan muncul setelah ada transaksi paid yang
                          diproses.</p>
                      </div>
                      <% } else { %>
                        <div class="mt-5 space-y-4">
                          <% safeCashierMonitor.forEach((cashier)=> { %>
                            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
                              <div class="flex items-start justify-between gap-4">
                                <div>
                                  <h4 class="text-base font-semibold text-slate-900">
                                    <%= cashier.cashier_name %>
                                  </h4>
                                  <p class="mt-1 text-sm text-slate-500">
                                    <%= cashier.total_transactions %> transaksi paid
                                  </p>
                                </div>
                                <span
                                  class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
                                  Aktif
                                </span>
                              </div>

                              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                                <div class="rounded-2xl bg-white p-3">
                                  <p class="text-slate-500">Penjualan</p>
                                  <p class="mt-1 font-semibold text-slate-900">
                                    <%= cashier.total_sales_formatted %>
                                  </p>
                                </div>
                                <div class="rounded-2xl bg-white p-3">
                                  <p class="text-slate-500">Fee</p>
                                  <p class="mt-1 font-semibold text-slate-900">
                                    <%= cashier.total_fee_formatted %>
                                  </p>
                                </div>
                              </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                  </article>

                  <article
                    class="rounded-3xl bg-gradient-to-br from-blue-700 via-blue-700 to-blue-900 p-6 text-white shadow-soft">
                    <p class="text-sm font-medium text-blue-100/80">Insight Hari Ini</p>
                    <h3 class="mt-2 text-2xl font-semibold">Pantau penjualan, transaksi, dan performa kasir dari data
                      real-time database.</h3>
                    <p class="mt-3 text-sm leading-6 text-blue-100/80">
                      Filter periode memudahkan pembacaan performa harian, mingguan, bulanan, atau keseluruhan tanpa
                      meninggalkan dashboard.
                    </p>
                  </article>
                </section>

              </div>
        </section>
      </main>
  </div>
  <script>
    function submitVoid(form, invoice) {
      const reason = window.prompt(`Alasan void untuk invoice ${invoice}:`);
      if (reason === null) return false;
      const normalizedReason = reason.trim();
      if (normalizedReason.length < 3 || normalizedReason.length > 500) {
        window.alert("Alasan void harus terdiri dari 3-500 karakter.");
        return false;
      }
      form.querySelector("input[name='reason']").value = normalizedReason;
      return window.confirm(`Void transaksi ${invoice}? Tindakan ini tidak dapat dibatalkan.`);
    }

    const chartElement = document.getElementById("salesChart");
    if (chartElement) {
      const salesChartData = {
        labels: JSON.parse(decodeURIComponent(chartElement.dataset.labels || "%5B%5D")),
        totals: JSON.parse(decodeURIComponent(chartElement.dataset.totals || "%5B%5D"))
      };

      new Chart(chartElement, {
        type: "line",
        data: {
          labels: salesChartData.labels,
          datasets: [{
            label: "Total Penjualan",
            data: salesChartData.totals,
            borderColor: "#2563eb",
            backgroundColor: "rgba(37, 99, 235, 0.12)",
            fill: true,
            tension: 0.35,
            pointRadius: 4,
            pointBackgroundColor: "#2563eb"
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              ticks: {
                callback(value) {
                  return new Intl.NumberFormat("id-ID", {
                    style: "currency",
                    currency: "IDR",
                    maximumFractionDigits: 0
                  }).format(value);
                }
              }
            }
          }
        }
      });
    }
  </script>
<%- include("../partials/footer", { flash }) %>
